# SerpApi API Key (Required for fetching real Google Trends data)
# Get your key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=""

# Groq API Key (Primary AI engine for opportunity generation & evidence interpretation)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Groq Model (Recommended: llama-3.3-70b-versatile or openai/gpt-oss-20b)
GROQ_MODEL="llama-3.3-70b-versatile"

# Gemini API Key (Companion / fallback AI engine if Groq key is not provided)
# Automatically injected in AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port for the Node.js Express server
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
